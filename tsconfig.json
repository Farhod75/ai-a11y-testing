{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["playwright-tests/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist"]
}